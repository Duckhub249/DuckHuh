    for _, root in ipairs({ ReplicatedStorage, game:GetService("SoundService"), LocalPlayer, Workspace }) do
        for _, d in ipairs(root:GetDescendants()) do
            if d.ClassName == "Sound" then hookPuzzleSound(d) end
        end
    end
    Workspace.DescendantAdded:Connect(function(d)
        if d.ClassName == "Sound" then hookPuzzleSound(d) end
