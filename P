    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for obj, cat in pairs(trackedESP) do
        if cat == "Gear" and obj and obj.Parent then
            local part = getESPPart(obj)
            if part then
                table.insert(result, { obj = obj, dist = myHRP and (part.Position - myHRP.Position).Magnitude or 0 })
            end
        end
    end
    table.sort(result, function(a, b) return a.dist < b.dist end)
    return result
end
