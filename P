local function getNearestTarget(targetCategory, maxRange)
    local character = LocalPlayer.Character
    if not character then return nil end
    local myHRP = character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local nearest = nil
    if targetCategory == "Killer" and getNearestKiller then
        nearest = getNearestKiller(maxRange)
    end
    return nearest
end

local snapAim, startAimbot
do
local aimStates = setmetatable({}, { __mode = "k" })

-- flat (XZ) velocity of the target: replicated velocity when available, otherwise measured
local function getTargetFlatVelocity(target)
    local state = aimStates[target]
    if not state then
        state = { vel = Vector3.new(0, 0, 0) }
        aimStates[target] = state
    end
    local now = os.clock()
    local pos = target.Position
    if state.lastPos and now > state.lastT then
        local d = (pos - state.lastPos) / (now - state.lastT)
        state.vel = state.vel:Lerp(Vector3.new(d.X, 0, d.Z), 0.4)
    end
    state.lastPos, state.lastT = pos, now
    local v = target.AssemblyLinearVelocity
    local flat = Vector3.new(v.X, 0, v.Z)
    if flat.Magnitude > 1 then return flat end
    return state.vel
end

-- where to aim: the target's position pushed forward by (ping + a little) along its velocity.
-- `prediction` scales that lead (0.4 = the default, 1x)
local function computeAimPoint(target, prediction)
    local pos = target.Position
    local vel = getTargetFlatVelocity(target)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local dist = hrp and (pos - hrp.Position).Magnitude or 20
    local lead = (getPingCompensation() + 0.05) * ((prediction or 0.4) / 0.4)
    lead = math.clamp(lead, 0, 0.6)
    if dist < 6 then lead = lead * 0.6 end
    return pos + vel * lead
end

-- instantly face the target (character always; camera too unless mode == "CharOnly"), no smoothing
function snapAim(target, prediction, mode)
    if not target or not target.Parent then return end
    local char = LocalPlayer.Character
    local HRP = char and char:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    local p = computeAimPoint(target, prediction)
    HRP.CFrame = CFrame.new(HRP.Position, Vector3.new(p.X, HRP.Position.Y, p.Z))
    if mode ~= "CharOnly" then
        local camera = Workspace.CurrentCamera
        if camera then camera.CFrame = CFrame.new(camera.CFrame.Position, p) end
    end
end

function startAimbot(target, duration, speed, predictionOverride, mode)
    if not target or not target.Parent then return end
    if activeAimbotLoop then
        activeAimbotLoop:Disconnect()
        activeAimbotLoop = nil
    end
    local startTime = os.clock()
    local lockDuration = duration or Settings.AimbotDuration or 1
    local aimAlpha = math.clamp(speed or Settings.AimbotSpeed or 1, 0.01, 1)
    local prediction = predictionOverride or Settings.AimbotPrediction or 0.4
    local lockCamera = mode ~= "CharOnly" -- skip the camera branch entirely in character-only mode (less work per frame)
    activeAimbotLoop = RunService.RenderStepped:Connect(function()
        if os.clock() - startTime >= lockDuration or not target or not target.Parent or not LocalPlayer.Character then
            if activeAimbotLoop then
                activeAimbotLoop:Disconnect()
                activeAimbotLoop = nil
            end
            return
        end
        local HRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not HRP then return end
        local p = computeAimPoint(target, prediction)
        if lockCamera then
            local camera = Workspace.CurrentCamera
            if camera then
                camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, p), aimAlpha)
            end
        end
        local flatTarget = CFrame.new(HRP.Position, Vector3.new(p.X, HRP.Position.Y, p.Z))
        HRP.CFrame = HRP.CFrame:Lerp(flatTarget, aimAlpha)
    end)
end
end

