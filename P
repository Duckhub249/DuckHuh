        local disp = string.lower(npcHum.DisplayName or "")
        if string.find(disp, "npc", 1, true) or string.find(disp, "shopkeep", 1, true) or string.find(disp, "merchant", 1, true) then
            return true
        end
    end
    local current = obj.Parent
    while current and current ~= Workspace do
        local pName = string.lower(current.Name)
        if string.find(pName, "npc", 1, true) then return true end
        if string.find(pName, "lobby", 1, true) then return true end
        if string.find(pName, "shop", 1, true) then return true end
        if string.find(pName, "safezone", 1, true) then return true end
        if string.find(pName, "camp", 1, true) then return true end
        current = current.Parent
    end
    return false
end

local refreshKillerKinds, isKillerSideMinion, isJohnDoeSummon
do
local function normName(s)
    return (string.gsub(string.lower(tostring(s or "")), "[%s_%-%.]", ""))
end

-- which killers are currently in the match (cached for 0.4s, classification calls this a lot)
local killerKinds = { t = 0, c00l = false, ones = false, jd = false }
function refreshKillerKinds()
    local now = os.clock()
    if now - killerKinds.t < 0.4 then return killerKinds end
    killerKinds.t = now
    killerKinds.c00l, killerKinds.ones, killerKinds.jd = false, false, false
    for _, plr in ipairs(Players:GetPlayers()) do
        local ch = plr.Character
        if ch then
            local n = normName(ch.Name)
            if string.find(n, "c00lkidd", 1, true) or string.find(n, "coolkid", 1, true) then
                killerKinds.c00l = true
            elseif string.find(n, "1x1x1x1", 1, true) then
                killerKinds.ones = true
            elseif string.find(n, "johndoe", 1, true) then
                killerKinds.jd = true
            end
        end
    end
    return killerKinds
end

-- "killer" / "survivor" / nil for a Player
local function playerSide(plr)
    local ch = plr and plr.Character
    if not ch then return nil end
    local cname = string.lower(ch.Name)
    for kn in pairs(KillerNamesList) do
        if string.find(normName(cname), normName(kn), 1, true) then return "killer" end
    end
    if string.find(cname, "killer", 1, true) then return "killer" end
    return "survivor"
end

-- who summoned this thing, when the game tells us (attributes / ObjectValues); nil = unknown
local function getSummonOwnerSide(obj)
    local function fromValue(v)
        local plr = nil
        if typeof(v) == "Instance" then
            if v:IsA("Player") then plr = v
            elseif v:IsA("Model") then plr = Players:GetPlayerFromCharacter(v) end
        elseif type(v) == "number" then
            plr = Players:GetPlayerByUserId(v)
        elseif type(v) == "string" and v ~= "" then
            plr = Players:FindFirstChild(v)
            if not plr then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.DisplayName == v then plr = p break end
                end
            end
        end
        return plr and playerSide(plr) or nil
    end
    local keys = { "Owner", "OwnerId", "OwnerUserId", "OwnerName", "Summoner", "Creator", "Caster", "Player", "Source", "ParentPlayer", "UserId" }
    for _, key in ipairs(keys) do
        local side = fromValue(obj:GetAttribute(key))
        if side then return side end
        local child = obj:FindFirstChild(key)
        if child and child:IsA("ValueBase") then
            side = fromValue(child.Value)
            if side then return side end
        end
    end
    local cur = obj.Parent
    while cur and cur ~= Workspace do
        local pn = string.lower(cur.Name)
        if string.find(pn, "survivor", 1, true) then return "survivor" end
        if string.find(pn, "killer", 1, true) then return "killer" end
        cur = cur.Parent
    end
    return nil
end

local KillerMinionWords = { "pizza", "delivery", "zombie", "minimon", "minion" }

-- ONLY minions that belong to the killers c00lkidd / 1x1x1x1 (never survivor-side summons, never NPCs)
function isKillerSideMinion(obj)
    if not obj or not obj:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    if not obj:FindFirstChildOfClass("Humanoid") then return false end
    local kinds = refreshKillerKinds()
    if not (kinds.c00l or kinds.ones) then return false end
    if isNPC(obj) then return false end
    local ownerSide = getSummonOwnerSide(obj)
    if ownerSide == "survivor" then return false end
    local n = normName(obj.Name)
    local matched = false
    for _, w in ipairs(KillerMinionWords) do
        if string.find(n, w, 1, true) then matched = true break end
    end
    if not matched and ownerSide ~= "killer" then return false end
    if string.find(n, "pizza", 1, true) or string.find(n, "delivery", 1, true) then
        return kinds.c00l
    end
    if string.find(n, "zombie", 1, true) then
        return kinds.ones
    end
    return true
end

local JohnDoeShadowWords = { "shadow" }

local function matchesShadowWord(inst)
    local n = normName(inst.Name)
    for _, w in ipairs(JohnDoeShadowWords) do
        if string.find(n, w, 1, true) then return true end
    end
    return false
end

-- ONLY things that belong to John Doe (killer side), and only the top-most object of each
function isJohnDoeSummon(obj)
    if not obj or not obj.Parent then return false end
    if not refreshKillerKinds().jd then return false end
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return false end
    local own = matchesShadowWord(obj)
    if not own and obj.Parent:IsA("Folder") and obj.Parent ~= Workspace and matchesShadowWord(obj.Parent) then
        own = true
    end
    if not own then return false end
    local cur = obj
    while cur and cur ~= Workspace do
        if cur:IsA("Model") and Players:GetPlayerFromCharacter(cur) then return false end
        cur = cur.Parent
    end
    local parent = obj.Parent
    if parent ~= Workspace and (parent:IsA("Model") or parent:IsA("BasePart")) and matchesShadowWord(parent) then
        return false
    end
    if obj:IsA("Model") and isNPC(obj) then return false end
    return true
end
end

-- players only count while a real match is running (not the lobby):
-- they must sit in the Killers / Survivors folder (when the game has them) AND real generators must exist
local function isInActiveMatch(char)
    local playersFolder = Workspace:FindFirstChild("Players")
    if playersFolder and (playersFolder:FindFirstChild("Killers") or playersFolder:FindFirstChild("Survivors")) then
        local inFolder = false
        local cur = char.Parent
        while cur and cur ~= Workspace do
            local n = string.lower(cur.Name)
            if n == "killers" or n == "survivors" or n == "killer" or n == "survivor" then
                inFolder = true
                break
            end
            cur = cur.Parent
        end
        if not inFolder then return false end
    end
    for gen, cat in pairs(trackedESP) do
        if cat == "Generators" and gen.Parent then return true end
    end
    return false
end

local function classifyESPObject(obj)
    if not obj or not obj.Parent then return nil end
    if isInLobby(obj) then return nil end
    if not (obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("BasePart")) then return nil end
    if LocalPlayer.Character and (obj == LocalPlayer.Character or obj:IsDescendantOf(LocalPlayer.Character)) then return nil end
    if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) == LocalPlayer then return nil end
    if isFakeGenerator(obj) then return nil end
    local name = string.lower(obj.Name)
    if obj:IsA("Model") and isKillerSideMinion(obj) then
        return "Bot"
    end
    if obj:IsA("BasePart") or obj:IsA("Model") then
        if isJohnDoeSummon(obj) then
            return "Shadow"
        end
    end
    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
        local player = Players:GetPlayerFromCharacter(obj)
        -- a non-player rig is only ever a killer-side minion (handled above), nothing else
        if not player then return nil end
        if not isInActiveMatch(obj) then return nil end -- lobby players are never shown
        for killerName in pairs(KillerNamesList) do
            if string.find(name, killerName, 1, true) then return "Killer" end
        end
        if string.find(name, "killer", 1, true) then return "Killer" end
        if not player then
            local botKeywords = {
                "summon", "decoy", "helper", "harp", "guitar",
                "pizzadeliveryrig", "blue", "green", "purple", "red", "mafia", "corrupt"
            }
            for _, keyword in ipairs(botKeywords) do
                if string.find(name, keyword, 1, true) then
                    return "Bot"
                end
            end
            if hasFullRig(obj) and not isNPC(obj) then
                return "Bot"
            end
        end
        if player and player ~= LocalPlayer then return "Survivors" end
        for survivorName in pairs(SurvivorNamesList) do
            if string.find(name, survivorName, 1, true) then return "Survivors" end
        end
        if string.find(name, "survivor", 1, true) then return "Survivors" end
        return nil
    end
    if string.find(name, "generator", 1, true) then
        if isFakeGenerator(obj) then return nil end
        return "Generators"
    end
    if name == "bloxycola" or name == "bloxy cola" then
        if obj:IsA("Tool") and not isInPlayerInventory(obj) and not isInLobby(obj) then return "BloxyCola" end
        return nil
    end
    if name == "medkit" or name == "med kit" then
        if obj:IsA("Tool") and not isInPlayerInventory(obj) and not isInLobby(obj) then return "Medkit" end
        return nil
    end
    if name == "digital footprint" or name == "digitalfootprint" then
        if not isInPlayerInventory(obj) then
            if refreshKillerKinds().jd then return "Shadow" end
            return "DigitalFootprint"
        end
        return nil
    end
    if isGearItem(obj) then
        return "Gear"
    end
    return nil
end

local function getESPPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
end

local GenDoneNames = { "completed", "complete", "done", "repaired", "finished", "fixed", "isdone", "iscomplete" }

local function normalizeGenProgress(n)
    if type(n) ~= "number" or n ~= n or n < 0 or n > 100 then return nil end
    if n > 0 and n < 1 then return n end -- already a 0..1 fraction
    return n / 100
end

local function isProgressName(name, exact)
    local lname = string.lower(name)
    if exact then return lname == "progress" end
    return string.find(lname, "progress", 1, true) ~= nil
        or string.find(lname, "percent", 1, true) ~= nil
        or string.find(lname, "completion", 1, true) ~= nil
end

local function isDoneName(name)
    local lname = string.lower(name)
    for _, w in ipairs(GenDoneNames) do
        if lname == w then return true end
    end
    return false
end

local function scanGeneratorProgress(genObj, exact)
    for name, val in pairs(genObj:GetAttributes()) do
        if type(val) == "number" and isProgressName(name, exact) then
            local p = normalizeGenProgress(val)
            if p then return p end
        end
    end
    for _, d in ipairs(genObj:GetDescendants()) do
        if (d:IsA("NumberValue") or d:IsA("IntValue")) and isProgressName(d.Name, exact) then
            local p = normalizeGenProgress(d.Value)
            if p then return p end
        end
    end
    return nil
end

-- generators we KNOW are finished (puzzlesDone sound played next to them)
local completedGens = setmetatable({}, { __mode = "k" })

-- the percentage the game itself draws next to the generator (e.g. a TextLabel "100")
local function scanGeneratorText(genObj)
    for _, d in ipairs(genObj:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            local t = string.match(tostring(d.Text), "^%s*(%d+%.?%d*)%s*%%?%s*$")
            local v = t and tonumber(t)
            if v and v >= 0 and v <= 100 then return v / 100 end
        end
    end
    return nil
end

local GenAttrWords = { "progress", "percent", "completion", "complete", "done", "repaired", "finished", "fixed" }

-- attributes / values on ANY part inside the generator (the model is nested: Generator > Instances > Generator > Cube...)
local function scanGeneratorDeep(genObj)
    local function nameMatches(name)
        local l = string.lower(name)
        for _, w in ipairs(GenAttrWords) do
            if string.find(l, w, 1, true) then return true end
        end
        return false
    end
    local function check(inst)
        for name, val in pairs(inst:GetAttributes()) do
            if nameMatches(name) then
                if val == true then return 1 end
                if type(val) == "number" and val >= 0 and val <= 100 then
                    if val > 1 then return val / 100 end
                    return val
                end
            end
        end
        return nil
    end
    local hit = check(genObj)
    if hit ~= nil then return hit end
    for _, d in ipairs(genObj:GetDescendants()) do
        hit = check(d)
        if hit ~= nil then return hit end
    end
    return nil
end

-- last resort: a generator whose repair prompt WAS available and has been switched off for a few
-- seconds (and is not the one we are standing next to, we may be mid-puzzle) is finished
local genPromptState = setmetatable({}, { __mode = "k" })
local function generatorPromptSaysDone(genObj)
    local st = genPromptState[genObj]
    if not st then
        st = { had = false, offSince = nil }
        genPromptState[genObj] = st
    end
    local anyEnabled = false
    for _, d in ipairs(genObj:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            anyEnabled = true
            break
        end
    end
    if anyEnabled then
        st.had = true
        st.offSince = nil
        return false
    end
    if not st.had then return false end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local part = getESPPart(genObj)
    if hrp and part and (part.Position - hrp.Position).Magnitude < 18 then
        st.offSince = nil
        return false
    end
    st.offSince = st.offSince or os.clock()
    return os.clock() - st.offSince >= 4
end

local function getGeneratorProgressPercent(genObj)
    if not genObj then return nil end
    if completedGens[genObj] then return 1 end
    for name, val in pairs(genObj:GetAttributes()) do
        if val == true and isDoneName(name) then return 1 end
    end
    for _, d in ipairs(genObj:GetDescendants()) do
        if d:IsA("BoolValue") and d.Value and isDoneName(d.Name) then return 1 end
    end
    local exactHit = scanGeneratorProgress(genObj, true)
    if exactHit ~= nil then return exactHit end
    local fuzzyHit = scanGeneratorProgress(genObj, false)
    if fuzzyHit ~= nil then return fuzzyHit end
    local deepHit = scanGeneratorDeep(genObj)
    if deepHit ~= nil then return deepHit end
    local textHit = scanGeneratorText(genObj)
    if textHit ~= nil then return textHit end
    if generatorPromptSaysDone(genObj) then
        completedGens[genObj] = true
        return 1
    end
    return nil
end

-- puzzlesDone = the last puzzle of a generator was solved: the generator next to us is at 100%
do
local function markNearestGeneratorDone()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local best, bestDist = nil, 45
    for obj, cat in pairs(trackedESP) do
        if cat == "Generators" and obj and obj.Parent then
            local part = getESPPart(obj)
            if part then
                local d = (part.Position - hrp.Position).Magnitude
                if d < bestDist then best, bestDist = obj, d end
            end
        end
    end
    if best then completedGens[best] = true end
end

local hookedPuzzleSounds = {}
local function hookPuzzleSound(s)
    if s.Name ~= "puzzlesDone" or hookedPuzzleSounds[s] then return end
    hookedPuzzleSounds[s] = true
    s.Played:Connect(markNearestGeneratorDone)
    s:GetPropertyChangedSignal("Playing"):Connect(function()
        if s.Playing then markNearestGeneratorDone() end
    end)
end

