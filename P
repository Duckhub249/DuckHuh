local activeHitboxes = {}

local hitboxConnections = {}

-- Slasher's Behead cannot be blocked at all: firing block or spawning a hitbox for it is
-- pointless and can even interrupt our own block timing for the NEXT real attack. We detect
-- it purely by the animation/track NAME (the numeric id was never reliable across updates)
-- and simply do nothing while it plays. No setting needed, this is always on.
local currentlyBeheading = {}
local function isBeheadTrack(track)
    local n = string.lower(tostring(track.Name or ""))
    if string.find(n, "behead", 1, true) then return true end
    local anim = track.Animation
    local an = anim and string.lower(tostring(anim.Name or "")) or ""
    return string.find(an, "behead", 1, true) ~= nil
end

local function getAnimId(animIdStr)
    return animIdStr and string.match(tostring(animIdStr), "%d+")
end

local function killHitboxImmediately(character)
    if activeHitboxes[character] then
        activeHitboxes[character]:Destroy()
        activeHitboxes[character] = nil
    end
    if hitboxConnections[character] then
        for _, conn in ipairs(hitboxConnections[character]) do
            conn:Disconnect()
        end
        hitboxConnections[character] = nil
    end
end

local function hookCharacterAnimations(character)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 3)
    local animator = humanoid and humanoid:WaitForChild("Animator", 3)
    if animator then
        animator.AnimationPlayed:Connect(function(track)
            if isBeheadTrack(track) then
                currentlyBeheading[character] = true
                killHitboxImmediately(character)
                task.delay((track.Length and track.Length > 0) and track.Length or 2.5, function()
                    currentlyBeheading[character] = nil
                end)
                return
            end
            if not track.Animation then return end
            local playId = getAnimId(track.Animation.AnimationId)
            if not playId then return end
            if Settings.AutoBlockAnimation and BlockAnimationIDs and BlockAnimationIDs[playId] then
                if character ~= LocalPlayer.Character and Settings.MasterAutoBlock and not currentlyBeheading[character] then
                    performBlock()
                    spawnHitboxAndCheck(character, BlockAnimationIDs[playId])
                end
            end
        end)
    end
end

