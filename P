local function destroyESPVisuals(obj)
    if not obj then return end
    local hl = obj:FindFirstChild("DuckHighlight")
    if hl then hl:Destroy() end
    local lbl = obj:FindFirstChild("DuckESPLabel")
    if lbl then lbl:Destroy() end
end

local updateESPLabel
do
local ESPRoleCats = { Killer = true, Survivors = true, Generators = true, BloxyCola = true, Medkit = true, DigitalFootprint = true, Gear = true, Shadow = true }
local ESPDistCats = { Killer = true, Survivors = true, Generators = true, BloxyCola = true, Medkit = true, DigitalFootprint = true, Gear = true }
local ESPPlayerCats = { Killer = true, Survivors = true }

local function buildESPLabelText(obj, catKey, percent)
    local lines = {}
    if Settings.EspShowRoleName and ESPRoleCats[catKey] then
        local txt
        if catKey == "Generators" then
            txt = "Generator"
            if percent ~= nil then txt = txt .. " " .. tostring(math.floor(percent * 100 + 0.5)) .. "%" end
        elseif catKey == "Shadow" then
            txt = "Shadow"
        else
            txt = obj.Name
        end
        lines[#lines + 1] = txt
    end
    if Settings.EspShowPlayerName and ESPPlayerCats[catKey] then
        local plr = Players:GetPlayerFromCharacter(obj)
        if plr then lines[#lines + 1] = plr.Name end
    end
    if Settings.EspShowHealth and ESPPlayerCats[catKey] then
        local hum = obj:FindFirstChildOfClass("Humanoid")
        if hum then
            lines[#lines + 1] = "HP " .. tostring(math.floor(hum.Health + 0.5)) .. "/" .. tostring(math.floor(hum.MaxHealth + 0.5))
        end
    end
    if Settings.EspShowDistance and ESPDistCats[catKey] then
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local part = getESPPart(obj)
        if myHRP and part then
            lines[#lines + 1] = tostring(math.floor((part.Position - myHRP.Position).Magnitude + 0.5)) .. "m"
        end
    end
    return table.concat(lines, "\n"), #lines
end

function updateESPLabel(obj, catKey, color, percent)
    local label = obj:FindFirstChild("DuckESPLabel")
    local text, count = buildESPLabelText(obj, catKey, percent)
    local part = getESPPart(obj)
    if count == 0 or not part then
        if label then label.Enabled = false end
        return
    end
    local size = math.clamp(tonumber(Settings.EspLabelTextSize) or 14, 8, 40)
    if not label then
        label = Instance.new("BillboardGui")
        label.Name = "DuckESPLabel"
        label.AlwaysOnTop = true
        label.LightInfluence = 0
        label.Parent = obj
        local labelText = Instance.new("TextLabel")
        labelText.Name = "Text"
        labelText.Size = UDim2.new(1, 0, 1, 0)
        labelText.BackgroundTransparency = 1
        labelText.Font = Enum.Font.GothamBold
        labelText.TextStrokeTransparency = 0.3
        labelText.Parent = label
    end
    label.Adornee = part
    label.Size = UDim2.new(0, 240, 0, count * (size + 4) + 4)
    local height = part.Size.Y
    if obj:IsA("Model") then
        local ok, ext = pcall(function() return obj:GetExtentsSize().Y end)
        if ok and ext then height = ext end
    end
    label.StudsOffset = Vector3.new(0, math.min(height / 2, 6) + 1.5 + count * size / 30, 0)
    local labelText = label:FindFirstChild("Text")
    if labelText then
        labelText.TextSize = size
        labelText.Text = text
        labelText.TextColor3 = color
    end
    label.Enabled = true
end
end

local function updateSingleESP(obj, catKey)
    if not obj or not obj.Parent or isInLobby(obj) or isFakeGenerator(obj) then return end
    local info = ESPCategories[catKey]
    if not info then return end
    local isEnabled = Settings[info.ConfigKey]
    local color = Settings[info.ColorKey]
    local percent = nil
    if catKey == "Generators" then
        percent = getGeneratorProgressPercent(obj)
        if percent == nil then
            -- unknown progress: keep the configured colour
        elseif percent >= 0.999 then
            color = Color3.fromRGB(0, 255, 0)
        elseif percent >= 0.8 then
            color = Color3.fromRGB(150, 255, 0)
        elseif percent >= 0.6 then
            color = Color3.fromRGB(255, 255, 0)
        elseif percent >= 0.4 then
            color = Color3.fromRGB(255, 170, 0)
        elseif percent >= 0.2 then
            color = Color3.fromRGB(255, 85, 0)
        else
            color = Color3.fromRGB(255, 0, 0)
        end
    end
    local highlight = obj:FindFirstChild("DuckHighlight")
    if isEnabled then
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "DuckHighlight"
            highlight.Adornee = obj
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = obj
        end
        local oldGearHL = obj:FindFirstChild("GearHighlight")
        if oldGearHL then oldGearHL:Destroy() end
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.Enabled = true
        updateESPLabel(obj, catKey, color, percent)
    else
        if highlight then highlight.Enabled = false end
        local label = obj:FindFirstChild("DuckESPLabel")
        if label then label.Enabled = false end
    end
end

local function refreshAllESP()
    for obj, catKey in pairs(trackedESP) do
        if isFakeGenerator(obj) then
            destroyESPVisuals(obj)
            trackedESP[obj] = nil
        else
            local isSelf = false
            if LocalPlayer.Character and (obj == LocalPlayer.Character or obj:IsDescendantOf(LocalPlayer.Character)) then isSelf = true end
            if obj and obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) == LocalPlayer then isSelf = true end
            local isDead = false
            if catKey == "Survivors" or catKey == "Killer" or catKey == "Bot" then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then isDead = true end
            end
            local isStale = false
            if (catKey == "Bot" or catKey == "Shadow" or catKey == "Killer" or catKey == "Survivors") and obj and obj.Parent then
                if classifyESPObject(obj) ~= catKey then isStale = true end
            end
            if obj and obj.Parent and not isInLobby(obj) and not isSelf and not isDead and not isStale then
                updateSingleESP(obj, catKey)
            else
                destroyESPVisuals(obj)
                if isDead or isStale or not obj or not obj.Parent then trackedESP[obj] = nil end
            end
        end
    end
end

local function registerESPObject(obj)
    if not obj or not obj.Parent then return end
    if isInLobby(obj) or isFakeGenerator(obj) then return end
    local catKey = classifyESPObject(obj)
    if not catKey then return end
    local currentParent = obj.Parent
    local isNested = false
    while currentParent and currentParent ~= Workspace do
        if isFakeGenerator(currentParent) then return end
        if trackedESP[currentParent] then
            isNested = true
            break
        end
        currentParent = currentParent.Parent
    end
    if not isNested or catKey == "Bot" or catKey == "Shadow" then
        trackedESP[obj] = catKey
        updateSingleESP(obj, catKey)
    end
end

local function pruneShadowESP()
    local maxCount = Settings.EspShadowMaxCount or 3
    if maxCount <= 0 then return end
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local shadows = {}
    for obj, cat in pairs(trackedESP) do
        if cat == "Shadow" and obj and obj.Parent then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or (obj:IsA("BasePart") and obj)
            if hrp then
                local dist = (hrp.Position - myHRP.Position).Magnitude
                table.insert(shadows, {obj = obj, dist = dist})
            end
        end
    end
    if #shadows <= maxCount then return end
    table.sort(shadows, function(a, b) return a.dist < b.dist end)
    for i = maxCount + 1, #shadows do
        local obj = shadows[i].obj
        destroyESPVisuals(obj)
        trackedESP[obj] = nil
    end
end

