local function isGearItem(obj)
    if not obj then return false end
    local isTool = obj:IsA("Tool")
    if not (isTool or obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    local name = string.lower(obj.Name)
    if name == "bloxycola" or name == "bloxy cola" or name == "medkit" or name == "med kit" then return false end
    if string.find(name, "digital footprint") then return false end
    if isGearBlacklistedName(name) then return false end
    -- cheap checks first (this runs for every object in Workspace)
    -- any Tool lying in the world, or anything with a ProximityPrompt (by this point obj is
    -- already known not to be a killer/survivor/generator/known item), counts as collectible gear
    local looksLikePickup = isTool or hasCollectPrompt(obj)
    if not looksLikePickup then return false end
    if isInLobby(obj) then return false end
    if isInPlayerInventory(obj) then return false end
    if LocalPlayer.Character and (obj == LocalPlayer.Character or obj:IsDescendantOf(LocalPlayer.Character)) then return false end
    if isInsideHumanoidModel(obj) then return false end
    return true
end

local function hasFullRig(model)
    if not model or not model:IsA("Model") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hrp = model:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end
    local function findPart(names)
        for _, n in ipairs(names) do
            if model:FindFirstChild(n) then return true end
        end
        return false
    end
    local hasHead = findPart({"Head", "head", "HEAD"})
    local hasTorso = findPart({"Torso", "UpperTorso", "LowerTorso", "torso", "Chest", "Body", "body"})
    local hasArms = findPart({
        "Left Arm", "Right Arm", "LeftArm", "RightArm",
        "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
        "LeftHand", "RightHand", "Arm", "arm"
    })
    local hasLegs = findPart({
        "Left Leg", "Right Leg", "LeftLeg", "RightLeg",
        "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
        "LeftFoot", "RightFoot", "Leg", "leg"
    })
    return hasHead and hasTorso and hasArms and hasLegs
end

