local function getMyRole()
    if Settings.ForceKillerProfile then return "Killer" end
    local character = LocalPlayer.Character
    if not character then return "Survivor" end
    -- 1) folder the character lives in (e.g. Workspace.Players.Killers / Survivors)
    local cur = character.Parent
    while cur and cur ~= Workspace do
        local n = string.lower(cur.Name)
        if n == "killers" or n == "killer" then return "Killer" end
        if n == "survivors" or n == "survivor" then return "Survivor" end
        cur = cur.Parent
    end
    -- 2) team
    local team = LocalPlayer.Team
    if team then
        local tn = string.lower(team.Name)
        if string.find(tn, "killer", 1, true) then return "Killer" end
        if string.find(tn, "survivor", 1, true) then return "Survivor" end
    end
    -- 3) attributes on the character / player
    for _, holder in ipairs({ character, LocalPlayer }) do
        for _, key in ipairs({ "Team", "Role", "Type", "Class" }) do
            local v = holder:GetAttribute(key)
            if type(v) == "string" then
                local lv = string.lower(v)
                if string.find(lv, "killer", 1, true) then return "Killer" end
                if string.find(lv, "survivor", 1, true) then return "Survivor" end
