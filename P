local function isYellowColor(c)
    if typeof(c) ~= "Color3" then return false end
    local h, s, v = c:ToHSV()
    return h >= 0.10 and h <= 0.23 and s >= 0.45 and v >= 0.6
end

local function isGuiShown(obj, root)
    local cur = obj
    while cur do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur == root then break end
        cur = cur.Parent
    end
    return true
end

local function yellowSourceOf(obj, root)
    if (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) and obj.ImageTransparency < 0.95
        and isYellowColor(obj.ImageColor3) and isGuiShown(obj, root) then
        return obj.Name .. ".ImageColor3"
    end
    if obj:IsA("UIStroke") and obj.Enabled and obj.Transparency < 0.95 and isYellowColor(obj.Color) then
        return obj.Name .. ".Color"
    end
    if obj:IsA("GuiObject") and obj.BackgroundTransparency < 0.9
        and isYellowColor(obj.BackgroundColor3) and isGuiShown(obj, root) then
        return obj.Name .. ".BackgroundColor3"
    end
    return nil
end

local function findYellowSource(root)
    local hit = yellowSourceOf(root, root)
    if hit then return hit end
    for _, d in ipairs(root:GetDescendants()) do
        hit = yellowSourceOf(d, root)
        if hit then return hit end
    end
    return nil
end

