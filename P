local function checkAutoPunch()
    if not Settings.AutoPunchEnabled then
        autoPunchWasYellow = false
        return
    end
    local now = os.clock()
    if not autoPunchButton or not autoPunchButton.Parent then
        autoPunchButton = nil
        if now - autoPunchLastScan < 0.5 then return end
        autoPunchLastScan = now
        autoPunchButton = findPunchButton()
        if not autoPunchButton then return end
    end
    local source = findYellowSource(autoPunchButton)
    local isYellow = source ~= nil
    if isYellow ~= autoPunchWasYellow and Settings.AutoPunchDebug then
        print("[DuckHub] Punch button yellow =", isYellow, source or "")
    end
    -- fire only on the white -> yellow change
    if isYellow and not autoPunchWasYellow and now - autoPunchLastFire >= 0.25 then
        autoPunchLastFire = now
        task.spawn(triggerAutoPunch)
    end
    autoPunchWasYellow = isYellow
end

