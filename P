local function triggerAutoPunch()
    local target = nil
    local prediction = Settings.AutoPunchAimPrediction or 0.4
    if Settings.AutoPunchAimbot then
        target = getNearestKiller(Settings.AutoPunchAimRange or 40)
        if target then
            local mode = Settings.AutoPunchAimMode
            snapAim(target, prediction, mode)
            startAimbot(
                target,
                Settings.AutoPunchAimDuration or 1,
                Settings.AutoPunchAimSpeed or 1,
                prediction,
                mode
            )
            -- let the new facing replicate before the punch is sent
            RunService.Heartbeat:Wait()
        end
    end
    local delaySec = Settings.AutoPunchDelay or 0
    if delaySec > 0 then task.wait(delaySec) end
    -- re-aim right before firing so the punch uses the freshest position of the killer
    if target and target.Parent then snapAim(target, prediction, Settings.AutoPunchAimMode) end
    performPunch()
