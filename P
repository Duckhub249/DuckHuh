    Instance.new("UICorner", list).CornerRadius = UDim.new(0, 4)
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = list
    local isOpen = false
    local rowH = 28

    local function rebuild()
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local options = cfg.GetOptions()
        local rows = math.min(#options, cfg.MaxRows or 5)
        list.Size = UDim2.new(1, 0, 0, rows * rowH)
        list.CanvasSize = UDim2.new(0, 0, 0, #options * rowH)
        for _, opt in ipairs(options) do
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 0, rowH)
            b.BackgroundColor3 = Color3.fromRGB(40, 120, 60)
            b.BackgroundTransparency = opt.selected and 0.35 or 1
            b.Text = (cfg.Multi and (opt.selected and "  [x] " or "  [ ] ") or "  ") .. opt.text
            b.TextColor3 = Color3.fromRGB(240, 240, 240)
            b.Font = Enum.Font.Gotham
            b.TextSize = 11
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.TextTruncate = Enum.TextTruncate.AtEnd
            b.Parent = list
            b.MouseButton1Click:Connect(function()
                cfg.OnSelect(opt.id)
                if not cfg.Multi then isOpen = false end
                list.Visible = isOpen
                holder.Size = UDim2.new(1, 0, 0, isOpen and (36 + rows * rowH) or 32)
                rebuild()
            end)
        end
        display.Text = cfg.GetDisplay()
        list.Visible = isOpen
        holder.Size = UDim2.new(1, 0, 0, isOpen and (36 + rows * rowH) or 32)
        arrow.Text = isOpen and "\u{25B2}" or "\u{25BC}"
    end

    local function toggle()
        isOpen = not isOpen
        rebuild()
    end
    arrow.MouseButton1Click:Connect(toggle)
    display.MouseButton1Click:Connect(toggle)
    table.insert(UILanguageRegistry, { Type = "Dropdown", Refresh = rebuild })
    rebuild()
    return { Refresh = rebuild }
end

local function createButton(parentTab, texts, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = color
    btn.Text = texts[Settings.Language]
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.Parent = parentTab
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    table.insert(UILanguageRegistry, { Type = "Tab", Obj = btn, Texts = texts })
    btn.MouseButton1Click:Connect(function() callback(btn) end)
    return btn
end

