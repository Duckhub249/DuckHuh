local cachedBlockBuffer = nil
pcall(function()
    local blockBytes = { 3, 5, 0, 0, 0, 66, 108, 111, 99, 107 }
    if buffer and buffer.create then
        cachedBlockBuffer = buffer.create(#blockBytes)
        for i = 1, #blockBytes do
            buffer.writeu8(cachedBlockBuffer, i - 1, blockBytes[i])
        end
    elseif buffer and buffer.fromstring then
        local str = ""
        for _, b in ipairs(blockBytes) do
            str = str .. string.char(b)
        end
        cachedBlockBuffer = buffer.fromstring(str)
    end
end)

local function makeAbilityBuffer(bytes)
    local ok, result = pcall(function()
        if buffer and buffer.create then
            local b = buffer.create(#bytes)
            for i = 1, #bytes do
                buffer.writeu8(b, i - 1, bytes[i])
            end
            return b
        elseif buffer and buffer.fromstring then
            local str = ""
            for _, byte in ipairs(bytes) do
                str = str .. string.char(byte)
            end
            return buffer.fromstring(str)
        end
        return nil
    end)
    if ok then return result end
    return nil
end

