-- a prompt counts as "collectible" when it says pick/take/grab/... or at least does not
-- say something that is clearly not a pickup (open / repair / hide / ...)
local function hasCollectPrompt(obj)
    -- the object's own name must not be a known non-gear thing (flag, point, door, lever, ...)
    if isGearBlacklistedName(string.lower(obj.Name)) then return false end
    local function check(p)
        if not p:IsA("ProximityPrompt") then return false end
        if promptLooksLikePickup(p) then return true end
        local text = string.lower(tostring(p.ActionText) .. " " .. tostring(p.ObjectText))
        for _, w in ipairs(NonPickupPromptWords) do
            if string.find(text, w, 1, true) then return false end
        end
        -- ambiguous prompt wording (neither clearly pick-up nor clearly not): only accept it
        -- when the object's own name is a known gear word, never by default
        local name = string.lower(obj.Name)
        for _, kw in ipairs(GearKeywords) do
            if string.find(name, kw, 1, true) then return true end
        end
        for _, kw in ipairs(GearStrictKeywords) do
            if string.find(name, kw, 1, true) then return true end
        end
        return false
    end
    for _, c in ipairs(obj:GetChildren()) do
        if check(c) then return true end
        if obj:IsA("Model") and c:IsA("BasePart") then
            for _, cc in ipairs(c:GetChildren()) do
                if check(cc) then return true end
            end
        end
    end
    return false
end

