-- Only touch a field while its option is ON. When it is turned OFF we put back the
-- value that was there before we changed it, but only if the game hasn't changed it
-- since (so values the game sets itself, e.g. killer = 110, are never overwritten).

local staminaOverrides = {}

local function applyStaminaField(sprint, field, enabled, value)
    local state = staminaOverrides[field]
    local current = sprint[field]
    if enabled and type(value) == "number" then
        if not state then
            state = { original = current }
            staminaOverrides[field] = state
        elseif state.applied ~= nil and current ~= state.applied then
            state.original = current -- the game changed it (new role / respawn)
        end
        sprint[field] = value
        state.applied = value
    elseif state then
        if state.applied ~= nil and current == state.applied then
            sprint[field] = state.original
        end
        staminaOverrides[field] = nil
    end
end

local cachedRole = "Survivor"
local lastRoleCheck = 0
local dumpSprintingFields
do

-- StaminaGain / StaminaLoss / SprintSpeed: the game keeps rewriting these, so a plain
-- assignment is overwritten again. We take the three fields out of the module table and
-- serve them through a metatable instead: the game still reads/writes "its" values, but
-- while an option is ON every read returns OUR value.
local staminaAliases = {
    StaminaGain = { "StaminaGain", "StaminaRegen", "StaminaRegenRate", "StaminaRecovery", "StaminaRecoveryRate", "RegenRate", "GainRate" },
    StaminaLoss = { "StaminaLoss", "StaminaDrain", "StaminaDrainRate", "StaminaCost", "DrainRate", "LossRate" },
    SprintSpeed = { "SprintSpeed", "SprintingSpeed", "RunSpeed", "SprintWalkSpeed" },
}
local staminaFuzzy = {
    StaminaGain = { "gain", "regen", "recover" },
    StaminaLoss = { "loss", "drain", "consum" },
    SprintSpeed = { "sprintspeed", "runspeed" },
}
local staminaNames = nil -- real field name in the module -> canonical name
local staminaReal, staminaOver = {}, {}
local staminaProxyOn = false

local function resolveStaminaNames(sprint)
    local names = {}
    for canonical, aliases in pairs(staminaAliases) do
        local found = nil
        for _, a in ipairs(aliases) do
            if type(rawget(sprint, a)) == "number" then
                found = a
                break
            end
        end
        if not found then
            for k, v in pairs(sprint) do
                if type(k) == "string" and type(v) == "number" then
                    local lk = string.lower(k)
                    if not string.find(lk, "max", 1, true) then
                        for _, pat in ipairs(staminaFuzzy[canonical]) do
                            if string.find(lk, pat, 1, true) then found = k break end
                        end
                    end
                end
                if found then break end
            end
        end
        names[found or canonical] = canonical
        names[canonical] = canonical
    end
    return names
end

local function installStaminaProxy(sprint)
    if staminaProxyOn then return end
    local ok = pcall(function()
        if setreadonly then pcall(setreadonly, sprint, false) end
        local old = getmetatable(sprint)
        if old ~= nil and type(old) ~= "table" then error("locked metatable") end
        local oldIndex = old and rawget(old, "__index")
        local oldNewIndex = old and rawget(old, "__newindex")
        local mt = {}
        if old then
            for k, v in pairs(old) do mt[k] = v end
        end
        mt.__index = function(t, k)
            local canonical = staminaNames[k]
            if canonical then
                local override = staminaOver[canonical]
                if override ~= nil then return override end
                return staminaReal[k]
            end
            if type(oldIndex) == "function" then return oldIndex(t, k) end
            if type(oldIndex) == "table" then return oldIndex[k] end
            return nil
        end
        mt.__newindex = function(t, k, v)
            if staminaNames[k] then
                staminaReal[k] = v
                return
            end
            if type(oldNewIndex) == "function" then return oldNewIndex(t, k, v) end
            if type(oldNewIndex) == "table" then oldNewIndex[k] = v return end
            rawset(t, k, v)
        end
        setmetatable(sprint, mt) -- if this throws nothing has been touched yet
        for name in pairs(staminaNames) do
            local v = rawget(sprint, name)
            if v ~= nil then
                staminaReal[name] = v
                rawset(sprint, name, nil)
            end
        end
    end)
    staminaProxyOn = ok
end

function dumpSprintingFields()
    local sprint = SprintingModule
    if not sprint then
        print("[DuckHub] Sprinting module not loaded yet")
        return
    end
    print("[DuckHub] Sprinting fields (proxy active = " .. tostring(staminaProxyOn) .. ")")
    for k, v in pairs(sprint) do
        print("   ", tostring(k), tostring(v), typeof(v))
    end
    for k, v in pairs(staminaReal) do
        print("   [proxied]", tostring(k), tostring(v), typeof(v))
    end
end

RunService.Heartbeat:Connect(function()
    local sprint = SprintingModule
    if not sprint then return end
    local now = os.clock()
    if now - lastRoleCheck >= 0.25 then
        lastRoleCheck = now
        cachedRole = getMyRole()
    end
    local prefix = (cachedRole == "Killer") and "Killer" or "Surv"
    pcall(function()
        if not staminaNames then
            staminaNames = resolveStaminaNames(sprint)
            installStaminaProxy(sprint)
        end
        applyStaminaField(sprint, "MaxStamina", Settings[prefix .. "EnableMaxStamina"], Settings[prefix .. "MaxStamina"])
        local function setField(canonical, enabledKey, valueKey)
            local enabled, value = Settings[prefix .. enabledKey], Settings[prefix .. valueKey]
            if staminaProxyOn then
                staminaOver[canonical] = (enabled and type(value) == "number") and value or nil
            else
                for name, canon in pairs(staminaNames) do
                    if canon == canonical then applyStaminaField(sprint, name, enabled, value) end
                end
            end
        end
        setField("StaminaGain", "EnableStaminaGain", "StaminaGain")
        setField("StaminaLoss", "EnableStaminaLoss", "StaminaLoss")
        setField("SprintSpeed", "EnableSprintSpeed", "SprintSpeed")
        if Settings[prefix .. "InfStamina"] and type(sprint.MaxStamina) == "number" then
            sprint.Stamina = sprint.MaxStamina
        end
    end)
end)

-- safety net for SprintSpeed: if the game still hands the Humanoid the ORIGINAL sprint speed,
-- replace exactly that value (never touches normal walking / other speeds)
RunService.RenderStepped:Connect(function()
    if not SprintingModule or not staminaNames then return end
    -- This only overwrites WalkSpeed in the exact frame where it still equals the REAL
    -- (un-overridden) sprint value -- i.e. the moment the game itself just applied its own
    -- speed -- so it never fights the proxy/module on the same frame (that double-write was
    -- the old stutter). Because of that guard it's safe to run this always, proxy on or off;
    -- gating it behind "proxy must be off" was the actual regression (Sprint stopped doing
    -- anything visible because the module-level override alone doesn't always reach WalkSpeed).
    local prefix = (cachedRole == "Killer") and "Killer" or "Surv"
    if not Settings[prefix .. "EnableSprintSpeed"] then return end
    local value = Settings[prefix .. "SprintSpeed"]
    if type(value) ~= "number" then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local original = nil
    for name, canon in pairs(staminaNames) do
        if canon == "SprintSpeed" then
            local r = staminaProxyOn and staminaReal[name] or (staminaOverrides[name] and staminaOverrides[name].original)
            if type(r) == "number" then original = r break end
        end
    end
    if original and math.abs(hum.WalkSpeed - original) < 0.05 and math.abs(original - value) > 0.05 then
        hum.WalkSpeed = value
    end
end)
end

